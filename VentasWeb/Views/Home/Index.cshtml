@{
    ViewBag.Title = "Home Page";
}

<!-- Bootstrap 5 CSS CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    body {
        background-color: #f8f9fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 5rem 2rem;
        border-radius: 1rem;
        box-shadow: 0 0 15px rgba(118, 75, 162, 0.4);
        text-align: center;
        margin-bottom: 3rem;
    }

        .hero-section h1 {
            font-weight: 700;
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .hero-section p.lead {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
            font-weight: 500;
        }

    .footer-text {
        font-size: 0.9rem;
        color: #212529;
    }

    .footer-link {
        font-weight: 700;
        color: #dc3545;
        text-decoration: none;
    }

        .footer-link:hover {
            text-decoration: underline;
        }
</style>

<div class="container">
    <section class="hero-section">
        <h1>Bienvenido</h1>
        <p class="lead">Usuario: @ViewBag.NombreUsuario</p>
        <p class="lead">ROL: @ViewBag.RolUsuario</p>
        <p class="footer-text mt-4">
            Todos los derechos reservados por palacios  &copy;
            <a class="nav-link" href="@Url.Action("Index", "Contacto")"><i class="fas fa-hands-helping me-2"></i>Contacto</a>
        </p>
    </section>
</div>

@section scripts{
    <!-- Bootstrap 5 Bundle JS (Popper + Bootstrap JS) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="@Url.Content("~/Scripts/Views/Home_Index.js")" type="text/javascript"></script>
}
